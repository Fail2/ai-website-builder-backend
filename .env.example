APP_NAME=AI Website Builder
APP_ENV=development
DEBUG=true

POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/ai_website_builder

MODEL_PROVIDER=openai
MODEL_NAME=openai/gpt-oss-120b
MODEL_API_KEY=your_groq_api_key
MODEL_BASE_URL=https://api.groq.com/openai/v1
TAVILY_API_KEY=your_tavily_api_key
FIRECRAWL_API_KEY=your_firecrawl_api_key

STRUCTURER_MODEL_PROVIDER=openai
STRUCTURER_MODEL_NAME=openai/gpt-oss-120b
STRUCTURER_MODEL_BASE_URL= https://api.groq.com/openai/v1
STRUCTURER_MODEL_API_KEY=your_groq_api_key

BRAND_MODEL_PROVIDER=openai
